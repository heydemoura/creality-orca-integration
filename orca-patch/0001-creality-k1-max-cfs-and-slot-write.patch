+// "#RRGGBB" -> "#0RRGGBB": the firmware stores colours with a literal '0' after the '#'
+// (Creality Print: `color.slice(0,1) + "0" + color.slice(1)`).
+static std::string to_creality_color(const std::string& hex)
+{
+    std::string v = hex;
+    if (!v.empty() && v[0] == '#')
+        v = v.substr(1);
+    if (v.size() == 8) // RRGGBBAA
+        v = v.substr(0, 6);
+    if (v.size() != 6)
+        return {};
+    std::transform(v.begin(), v.end(), v.begin(), [](unsigned char c) { return std::tolower(c); });
+    return "#0" + v;
+}
+
+static std::string from_creality_color(std::string v)
+{
+    if (!v.empty() && v[0] == '#')
+        v = v.substr(1);
+    if (v.size() == 7 && v[0] == '0')
+        v = v.substr(1);
+    std::transform(v.begin(), v.end(), v.begin(), [](unsigned char c) { return std::toupper(c); });
+    return v.size() == 6 ? "#" + v : std::string{};
+}
+
+static bool iequals(const std::string& a, const std::string& b)
+{
+    return boost::iequals(a, b);
+}
+
+bool CrealityPrint::modify_material(int box_id, int slot_id, const CfsMaterialSpec& spec, std::string& error) const
+{
+    error.clear();
+    try {
+        net::io_context ioc;
+        websocket::stream<beast::tcp_stream> ws{ioc};
+        ws_connect(ioc, ws, m_host, "9999");
+
+        // Refuse to touch the slot table while a job runs - Creality Print's UI applies the same
+        // interlock (edits only when deviceState == 0) and the firmware ignores or garbles the
+        // write otherwise. The state arrives in the status burst right after connecting.
+        beast::get_lowest_layer(ws).expires_after(std::chrono::seconds(6));
+        json state_query = {{"method", "get"}, {"params", {{"boxsInfo", 1}}}};
+        std::string state_msg = ws_send_and_read(ws, state_query, "deviceState", 10);
+        if (!state_msg.empty()) {
+            auto st = json::parse(state_msg, nullptr, false);
+            if (st.is_object() && st.contains("deviceState") && st["deviceState"].is_number() && st["deviceState"].get<int>() != 0) {
+                error = "the printer is busy (deviceState=" + std::to_string(st["deviceState"].get<int>()) + "); CFS slots can only be edited while idle";
+                beast::error_code close_ec;
+                ws.close(websocket::close_code::normal, close_ec);
+                return false;
+            }
+        }
+
+        json material;
+        if (spec.is_clear()) {
+            material = {{"boxId", box_id}, {"id", slot_id}, {"rfid", ""}, {"type", ""}, {"vendor", ""}, {"name", ""},
+                        {"color", ""}, {"minTemp", 0}, {"maxTemp", 0}, {"pressure", 0}};
+        } else {
+            const std::string color = to_creality_color(spec.color_hex);
+            if (color.empty()) {
+                error = "invalid colour \"" + spec.color_hex + "\" (expected #RRGGBB)";
+                return false;
+            }
+            // Creality Print adds 1e-8 so the temperatures serialise as floats; mirror it exactly.
+            material = {{"boxId", box_id},
+                        {"id", slot_id},
+                        {"rfid", spec.library_id},
+                        {"type", spec.type},
+                        {"vendor", spec.vendor},
+                        {"name", spec.name},
+                        {"color", color},
+                        {"minTemp", static_cast<double>(spec.min_temp) + 1e-8},
+                        {"maxTemp", static_cast<double>(spec.max_temp) + 1e-8},
+                        {"pressure", spec.pressure_advance}};
+        }
+        json cmd = {{"method", "set"}, {"params", {{"modifyMaterial", material}}}};
+        BOOST_LOG_TRIVIAL(info) << "CrealityPrint: modifyMaterial " << material.dump();
+
+        // The firmware answers {"modifyMaterial": <code>} and then pushes a fresh boxsInfo. Verify by
+        // reading the slot back rather than trusting the code, whose meaning differs between units.
+        beast::get_lowest_layer(ws).expires_after(std::chrono::seconds(8));
+        std::string ack = ws_send_and_read(ws, cmd, "modifyMaterial", 10);
+        if (!ack.empty())
+            BOOST_LOG_TRIVIAL(info) << "CrealityPrint: modifyMaterial acknowledged: " << ack;
+
+        bool verified = false;
+        for (int attempt = 0; attempt < 3 && !verified; ++attempt) {
+            beast::get_lowest_layer(ws).expires_after(std::chrono::seconds(6));
+            json boxs_query = {{"method", "get"}, {"params", {{"boxsInfo", 1}}}};
+            std::string result = ws_send_and_read(ws, boxs_query, "materialBoxs", 10);
+            if (result.empty())
+                continue;
+            auto resp = json::parse(result, nullptr, false);
+            if (!resp.is_object() || !resp.contains("boxsInfo") || !resp["boxsInfo"].contains("materialBoxs"))
+                continue;
+            for (const auto& box : resp["boxsInfo"]["materialBoxs"]) {
+                if (box.value("id", -1) != box_id || !box.contains("materials"))
+                    continue;
+                for (const auto& mat : box["materials"]) {
+                    if (mat.value("id", -1) != slot_id)
+                        continue;
+                    const std::string m_type  = mat.value("type", "");
+                    const std::string m_name  = mat.value("name", "");
+                    const std::string m_color = from_creality_color(mat.value("color", ""));
+                    if (spec.is_clear())
+                        verified = m_type.empty() && m_name.empty();
+                    else
+                        verified = iequals(m_type, spec.type) && iequals(m_name, spec.name) &&
+                                   (spec.color_hex.empty() || iequals(m_color, from_creality_color(spec.color_hex)));
+                }
+            }
+        }
+
+        beast::error_code close_ec;
+        beast::get_lowest_layer(ws).expires_after(std::chrono::seconds(3));
+        ws.close(websocket::close_code::normal, close_ec);
+
+        if (!verified)
+            error = "the printer did not apply the slot change" + (ack.empty() ? std::string(" (no acknowledgement)") : " (" + ack + ")");
+        return verified;
+    } catch (std::exception const& e) {
+        BOOST_LOG_TRIVIAL(error) << "CrealityPrint: modifyMaterial failed: " << e.what();
+        error = e.what();
+        return false;
+    }
+}
