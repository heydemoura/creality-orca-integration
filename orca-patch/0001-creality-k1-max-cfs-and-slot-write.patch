+namespace {
+
+// Build the slot record for OrcaSlicer's ams_filament_setting command. The command carries the
+// Orca filament_id (tray_info_idx), the colour as RRGGBBAA, the nozzle range and the base type;
+// vendor and product name come from the matching filament preset. An empty tray_info_idx + type is
+// the AMS dialog's "Reset" and clears the slot.
+bool ams_setting_to_spec(const json& print, CrealityPrint::CfsMaterialSpec& spec, int& ams_id, int& slot_id)
+{
+    try {
+        ams_id  = print.value("ams_id", 0);
+        slot_id = print.contains("slot_id") ? print.value("slot_id", 0) : print.value("tray_id", 0);
+    } catch (const std::exception&) {
+        return false;
+    }
+    const std::string filament_id = print.value("tray_info_idx", "");
+    const std::string tray_type   = print.value("tray_type", "");
+    std::string       color       = print.value("tray_color", "");
+
+    spec = CrealityPrint::CfsMaterialSpec{};
+    if (filament_id.empty() && tray_type.empty())
+        return true; // clear
+
+    if (color.size() == 8) color = color.substr(0, 6);
+    if (color.size() == 6) spec.color_hex = "#" + color;
+    spec.type     = tray_type;
+    spec.min_temp = print.value("nozzle_temp_min", 0);
+    spec.max_temp = print.value("nozzle_temp_max", 0);
+
+    // Vendor / product name / PA from the preset that owns this filament_id.
+    if (auto* bundle = GUI::wxGetApp().preset_bundle) {
+        const Preset* best = nullptr;
+        for (const auto& p : bundle->filaments.get_presets()) {
+            if (p.filament_id != filament_id) continue;
+            // Prefer system presets so user copies with odd names do not leak into the printer.
+            if (best == nullptr || (p.is_system && !best->is_system)) best = &p;
+        }
+        if (best != nullptr) {
+            if (const auto* fv = best->config.option<ConfigOptionStrings>("filament_vendor"); fv && !fv->values.empty())
+                spec.vendor = fv->values.front();
+            if (const auto* ft = best->config.option<ConfigOptionStrings>("filament_type"); ft && !ft->values.empty() && spec.type.empty())
+                spec.type = ft->values.front();
+            if (const auto* pa = best->config.option<ConfigOptionFloats>("pressure_advance"); pa && !pa->values.empty())
+                spec.pressure_advance = pa->values.front();
+            if (spec.min_temp == 0)
+                if (const auto* lo = best->config.option<ConfigOptionInts>("nozzle_temperature_range_low"); lo && !lo->values.empty())
+                    spec.min_temp = lo->values.front();
+            if (spec.max_temp == 0)
+                if (const auto* hi = best->config.option<ConfigOptionInts>("nozzle_temperature_range_high"); hi && !hi->values.empty())
+                    spec.max_temp = hi->values.front();
+            // "Hyper PLA @Creality K1 Max_CFS-C-all" -> "Hyper PLA"
+            spec.name = best->name.substr(0, best->name.find('@'));
+            boost::trim(spec.name);
+        }
+    }
+    if (spec.vendor.empty()) spec.vendor = "Generic";
+    if (spec.name.empty())   spec.name = (spec.vendor == "Generic" ? "Generic " : spec.vendor + " ") + spec.type;
+    if (spec.min_temp == 0)  spec.min_temp = 190;
+    if (spec.max_temp == 0)  spec.max_temp = 240;
+    // The library id ("rfid") is only known to the printer; leave it empty and let the firmware
+    // treat the record as a user material. Creality Print behaves the same for unknown names.
+    return !spec.type.empty();
+}
