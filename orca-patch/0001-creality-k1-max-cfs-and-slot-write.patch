+// Printer box ids of the active CFS units in AMS order. Mirrors the filtering in
+// parse_cfs_response(): inactive boxes and the external spool holder (type 1) are skipped.
+std::vector<int> CrealityPrintAgent::parse_cfs_box_ids(const std::string& response)
+{
+    std::vector<int> ids;
+    if (response.empty())
+        return ids;
+    json resp = json::parse(response, nullptr, false);
+    if (!resp.is_object() || !resp.contains("boxsInfo") || !resp["boxsInfo"].contains("materialBoxs"))
+        return ids;
+    for (const auto& box : resp["boxsInfo"]["materialBoxs"]) {
+        if (box.value("state", 0) != 1) continue;
+        if (box.value("type", 0) != 0)  continue;
+        ids.push_back(box.value("id", 0));
+    }
+    return ids;
+}
