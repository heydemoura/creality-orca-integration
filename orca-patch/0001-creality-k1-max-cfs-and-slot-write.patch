+int CrealityPrintAgent::send_message_to_printer(std::string dev_id, std::string json_str, int qos, int flag)
+{
+    json msg = json::parse(json_str, nullptr, false);
+    if (msg.is_object() && msg.contains("print") && msg["print"].is_object() &&
+        msg["print"].value("command", "") == "ams_filament_setting") {
+        if (device_info.dev_ip.empty())
+            return BAMBU_NETWORK_ERR_INVALID_HANDLE;
+
+        CrealityPrint::CfsMaterialSpec spec;
+        int ams_id = 0, slot_id = 0;
+        if (!ams_setting_to_spec(msg["print"], spec, ams_id, slot_id)) {
+            BOOST_LOG_TRIVIAL(warning) << "CrealityPrintAgent: malformed ams_filament_setting: " << json_str;
+            return BAMBU_NETWORK_ERR_INVALID_HANDLE;
+        }
+        if (ams_id < 0 || ams_id >= static_cast<int>(m_box_ids.size())) {
+            BOOST_LOG_TRIVIAL(warning) << "CrealityPrintAgent: ams_filament_setting for unknown AMS index " << ams_id
+                                       << " (known CFS boxes: " << m_box_ids.size() << ")";
+            return ORCA_NETWORK_ERR_CAP_NOT_AVAILABLE;
+        }
+        const int box_id = m_box_ids[ams_id];
+
+        DynamicPrintConfig cfg;
+        cfg.set_key_value("print_host",                  new ConfigOptionString("http://" + device_info.dev_ip));
+        cfg.set_key_value("print_host_webui",            new ConfigOptionString(""));
+        cfg.set_key_value("printhost_cafile",            new ConfigOptionString(""));
+        cfg.set_key_value("printhost_port",              new ConfigOptionString(""));
+        cfg.set_key_value("printhost_apikey",            new ConfigOptionString(device_info.api_key));
+        cfg.set_key_value("printhost_ssl_ignore_revoke", new ConfigOptionBool(false));
+        CrealityPrint host(&cfg);
+
+        std::string error;
+        const bool  ok = host.modify_material(box_id, slot_id, spec, error);
+        BOOST_LOG_TRIVIAL(info) << "CrealityPrintAgent: ams_filament_setting -> CFS box " << box_id << " slot " << slot_id
+                                << (ok ? " applied" : " FAILED: " + error);
+        if (ok) {
+            // Refresh the trays so the sidebar / device tab reflect the printer's view of the slot.
+            fetch_filament_info(dev_id);
+            return BAMBU_NETWORK_SUCCESS;
+        }
+        return BAMBU_NETWORK_ERR_INVALID_HANDLE;
+    }
+    return MoonrakerPrinterAgent::send_message_to_printer(std::move(dev_id), std::move(json_str), qos, flag);
+}
